diff --git a/core/libs/tests/GuestNpWebApi.cpp b/core/libs/tests/GuestNpWebApi.cpp
index 55fc787258..92193545ab 100644
--- a/core/libs/tests/GuestNpWebApi.cpp
+++ b/core/libs/tests/GuestNpWebApi.cpp
@@ -1,11 +1,15 @@
 #include "prx/libSceNpWebApi/include/Api.hpp"
+#include "prx/libSceNpCommon/include/Api.hpp"
 #include "prx/libc/include/general/VabiMacros.hpp"
+#include <algorithm>
 #include <cstddef>
 #include <cstdio>
 #include <cstdlib>
+#include <cstring>
 
 namespace {
 
+constexpr int NpInvalidArgument = static_cast<int>(0x80550003u);
 constexpr int InvalidArgument = static_cast<int>(0x80552902u);
 constexpr int LibContextNotFound = static_cast<int>(0x80552904u);
 constexpr int PushEventFilterNotFound = static_cast<int>(0x8055290Bu);
@@ -20,9 +24,31 @@ void Require(bool condition, const char* message) {
     }
 }
 
+void ParseNpId() {
+    NpIdFull npId;
+    std::memset(&npId, 0xa5, sizeof(npId));
+    const auto untouched = [&] { const auto* bytes = reinterpret_cast<const unsigned char*>(&npId); return std::all_of(bytes, bytes + sizeof(npId), [](unsigned char value) { return value == 0xa5; }); };
+    Require(sceNpWebApiUtilityParseNpId(nullptr, &npId) == NpInvalidArgument && untouched(), "a null serialized NP ID returns INVALID_ARGUMENT without writing the output");
+    Require(sceNpWebApiUtilityParseNpId("dXNlcjAxQGFiL2MuZA==", nullptr) == 0, "parse without an output");
+    Require(sceNpWebApiUtilityParseNpId("dXNlcjAxQGFiL2MuZA==", &npId) == 0, "parse user01@ab/c.d");
+    NpIdFull expected{};
+    std::memcpy(expected.handle.data, "user01", 6);
+    std::memcpy(expected.opt, "abcd", 4);
+    expected.reserved[0] = 1;
+    Require(std::memcmp(&npId, &expected, sizeof(npId)) == 0, "user01@ab/c.d gives online ID user01, opt abcd and reserved[0] 1 in a cleared NP ID");
+    std::memset(&npId, 0xa5, sizeof(npId));
+    Require(sceNpWebApiUtilityParseNpId("YWJjZGVmZ2hpamtsbW5vcHFyc3RAMTIzNC81Njc4Ljkw", &npId) == 0, "parse a long NP ID");
+    expected = {};
+    std::memcpy(expected.handle.data, "abcdefghijklmnop", 16);
+    std::memcpy(expected.opt, "12345678", 8);
+    expected.reserved[0] = 1;
+    Require(std::memcmp(&npId, &expected, sizeof(npId)) == 0, "a long NP ID keeps 16 online ID bytes and 8 opt bytes");
+}
+
 }
 
 int main() {
+    ParseNpId();
     const int context = sceNpWebApiInitialize(1, 0x10000);
     Require(context > 0 && context <= 0x7fff, "library context id out of range");
     const int other = sceNpWebApiInitialize(1, 0x10000);
diff --git a/docs/dev/debt/libSceNpWebApi.md b/docs/dev/debt/libSceNpWebApi.md
index 95fb314c74..7c956a0b7f 100644
--- a/docs/dev/debt/libSceNpWebApi.md
+++ b/docs/dev/debt/libSceNpWebApi.md
@@ -4,3 +4,4 @@
 
 - [sceNpWebApiInitialize, sceNpWebApiTerminate, sceNpWebApiCreateHandle, sceNpWebApiDeleteHandle, sceNpWebApiCreatePushEventFilter, sceNpWebApiDeletePushEventFilter](../../../core/libs/prx/libSceNpWebApi/Export.cpp) (libSceNpWebApi, PS4) - signatures, id ranges (library contexts 1 to 0x7fff, handles and filters below 0xf0000000) and errors (`LIB_CONTEXT_NOT_FOUND`, `HANDLE_NOT_FOUND`, `PUSH_EVENT_FILTER_NOT_FOUND`, `INVALID_ARGUMENT` for a missing filter parameter) follow [shadPS4](https://github.com/shadps4-emu/shadPS4/blob/main/src/core/libraries/np/np_web_api/np_web_api_internal.cpp); they are not checked on a console. The libHttp context and pool size are kept but not used, since no request is ever sent. Limbo (CUSA01664) creates a context, a handle and filters when its game starts.
 - [sceNpWebApiCreateServicePushEventFilter](../../../core/libs/prx/libSceNpWebApi/Export.cpp) (libSceNpWebApi, PS4) - a filter for a PSN service needs the signed-in user, and no user is signed in to PSN, so a valid call returns `SIGNED_IN_USER_NOT_FOUND` after the context and handle checks, as shadPS4 does with its network disabled. shadPS4 also rejects an invalid service label for titles built with SDK 2.00 or later; AnyPS5 has no compiled-SDK version for libraries yet, so such a call returns `SIGNED_IN_USER_NOT_FOUND` instead of `INVALID_ARGUMENT`. `sceNpWebApiDeleteServicePushEventFilter` therefore never finds a filter.
+- [sceNpWebApiUtilityParseNpId](../../../core/libs/prx/libSceNpWebApi/Export.cpp) (libSceNpWebApi, PS4) - decodes and splits the serialized NP ID as [shadPS4](https://github.com/shadps4-emu/shadPS4/blob/e0845a12dc05f2fde85e7b203c76de03f93a585d/src/core/libraries/np/np_web_api/np_web_api.cpp#L598-L630) does, which is not checked on a console: base64 decoding skips characters outside the alphabet and stops at `=`, the online ID keeps at most 16 bytes before `@`, `opt` keeps the first 8 bytes after it without `/` and `.`, and `reserved[0]` is set to 1 in an otherwise cleared 36-byte `NpIdFull`.
