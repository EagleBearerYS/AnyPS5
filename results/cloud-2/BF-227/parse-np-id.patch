From a45422d6473908a43aee0baa8880eedd82751d91 Mon Sep 17 00:00:00 2001
From: Yunus Shaikh <75296019+EagleBearerYS@users.noreply.github.com>
Date: Sun, 25 Oct 2026 12:27:16 +0000
Subject: [PATCH 2/2] feat(libSceNpWebApi): parse a serialized NP ID with
 sceNpWebApiUtilityParseNpId

shadPS4 implements the call (np_web_api.cpp L598-L630 at e0845a12dc):
a null string returns NP_ERROR_INVALID_ARGUMENT. Otherwise the string
is base64-decoded and split at '@': the online ID is the part before it
(at most 16 bytes), and opt is the part after it with '/' and '.'
removed (at most 8 bytes). With an output, the 36-byte NP ID is cleared,
both are copied in and reserved[0] is set to 1. The call returns 0.

The output is the tree's 36-byte NpIdFull from libSceNpCommon, which
matches shadPS4's OrbisNpId, not the shared 24-byte NpId.

guest_np_web_api checks the null string, a null output, user01@ab/c.d
(online ID user01, opt abcd, reserved[0] 1, everything else cleared) and
a long ID cut to 16 online ID bytes and 8 opt bytes.
---
 core/libs/prx/libSceNpWebApi/Export.cpp      | 44 +++++++++++++++++++-
 core/libs/prx/libSceNpWebApi/include/Api.hpp |  4 +-
 core/libs/tests/GuestNpWebApi.cpp            | 26 ++++++++++++
 docs/dev/debt/libSceNpWebApi.md              |  1 +
 4 files changed, 72 insertions(+), 3 deletions(-)

diff --git a/core/libs/prx/libSceNpWebApi/Export.cpp b/core/libs/prx/libSceNpWebApi/Export.cpp
index c78414d680..2651460073 100644
--- a/core/libs/prx/libSceNpWebApi/Export.cpp
+++ b/core/libs/prx/libSceNpWebApi/Export.cpp
@@ -1,12 +1,17 @@
 #include "prx/libSceNpWebApi/include/Api.hpp"
+#include "prx/libSceNpCommon/include/Api.hpp"
 #include "SceTypes.hpp"
 #include "prx/libc/include/General.hpp"
+#include <algorithm>
 #include <cstddef>
 #include <cstdint>
+#include <cstring>
 #include <mutex>
+#include <string>
 #include <unordered_map>
 #include <unordered_set>
 
+static constexpr int SCE_NP_ERROR_INVALID_ARGUMENT = static_cast<int>(0x80550003);
 static constexpr int SCE_NP_WEBAPI_ERROR_INVALID_ARGUMENT = static_cast<int>(0x80552902);
 static constexpr int SCE_NP_WEBAPI_ERROR_LIB_CONTEXT_NOT_FOUND = static_cast<int>(0x80552904);
 static constexpr int SCE_NP_WEBAPI_ERROR_PUSH_EVENT_FILTER_NOT_FOUND = static_cast<int>(0x8055290B);
@@ -174,8 +179,43 @@ int APS5_VABI sceNpWebApiUnregisterServicePushEventCallback() {
     return 0;
 }
 
-int APS5_VABI sceNpWebApiUtilityParseNpId() {
-    NotImplemented_nid_no_patch(__func__);
+int APS5_VABI sceNpWebApiUtilityParseNpId(const char* jsonNpId, NpIdFull* npId) {
+    if (jsonNpId == nullptr) return SCE_NP_ERROR_INVALID_ARGUMENT;
+    const auto sextet = [](char c) {
+        if (c >= 'A' && c <= 'Z') return c - 'A';
+        if (c >= 'a' && c <= 'z') return c - 'a' + 26;
+        if (c >= '0' && c <= '9') return c - '0' + 52;
+        if (c == '+') return 62;
+        if (c == '/') return 63;
+        return -1;
+    };
+    std::string decoded;
+    std::uint32_t buffer = 0;
+    int bits = 0;
+    for (const char* cursor = jsonNpId; *cursor != '\0' && *cursor != '='; ++cursor) {
+        const int value = sextet(*cursor);
+        if (value < 0) continue;
+        buffer = (buffer << 6) | static_cast<std::uint32_t>(value);
+        bits += 6;
+        if (bits >= 8) {
+            bits -= 8;
+            decoded.push_back(static_cast<char>((buffer >> bits) & 0xffu));
+        }
+    }
+    const auto at = decoded.find('@');
+    const std::string handle = decoded.substr(0, at);
+    std::string opt;
+    if (at != std::string::npos) {
+        for (std::size_t index = at + 1; index < decoded.size(); ++index) {
+            if (decoded[index] != '/' && decoded[index] != '.') opt.push_back(decoded[index]);
+        }
+    }
+    if (npId != nullptr) {
+        std::memset(npId, 0, sizeof(NpIdFull));
+        std::memcpy(npId->handle.data, handle.data(), std::min<std::size_t>(handle.size(), 16));
+        std::memcpy(npId->opt, opt.data(), std::min(opt.size(), sizeof(npId->opt)));
+        npId->reserved[0] = 1;
+    }
     return 0;
 }
 
