#version 450

layout(constant_id = 0) const uint UNORM_11_11_10 = 1u;

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Input { uint data[]; } inputBuffer;
layout(set = 0, binding = 1, std430) writeonly buffer Output { uint data[]; } outputBuffer;

layout(push_constant) uniform Push {
    uint count;
} push;

uint unormBits(uint value, uint bits) {
    if (value == 0u) return 0u;
    uint msb = uint(findMSB(value));
    uint leading = bits - 1u - msb;
    uint rotated = ((value << leading) | (value >> (bits - leading))) & ((1u << bits) - 1u);
    uint pattern = rotated << (32u - bits);
    for (uint shift = bits; shift < 32u; shift *= 2u) pattern |= pattern >> shift;
    return ((msb + 126u - bits) << 23u) + (pattern >> 8u) + ((pattern >> 7u) & 1u);
}

void main() {
    uint index = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 256u + gl_LocalInvocationID.x;
    if (index >= push.count) return;
    uint texel = inputBuffer.data[index];
    if (UNORM_11_11_10 != 0u) {
        outputBuffer.data[index * 4u] = unormBits(texel & 0x7ffu, 11u);
        outputBuffer.data[index * 4u + 1u] = unormBits((texel >> 11u) & 0x7ffu, 11u);
        outputBuffer.data[index * 4u + 2u] = unormBits(texel >> 22u, 10u);
        outputBuffer.data[index * 4u + 3u] = 0x3f800000u;
    } else {
        outputBuffer.data[index] = (texel >> 21u) | (((texel >> 10u) & 0x7ffu) << 11u) | ((texel & 0x3ffu) << 22u);
    }
}
